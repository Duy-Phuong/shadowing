{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shadowing-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "grammar-static",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const fs=require('fs'),p=require('path'),d=p.resolve('grammar');require('http').createServer((q,s)=>{let f;try{f=p.join(d,decodeURIComponent(q.url.split('?')[0]))}catch(e){s.writeHead(400);return s.end()}if(!f.startsWith(d+p.sep)){s.writeHead(403);return s.end()}fs.readFile(f,(e,b)=>{if(e){s.writeHead(404);return s.end()}s.writeHead(200,{'Content-Type':f.endsWith('.html')?'text/html; charset=utf-8':'application/octet-stream'});s.end(b)})}).listen(8765,'127.0.0.1')"],
      "port": 8765
    }
  ]
}
